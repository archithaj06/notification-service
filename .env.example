# Copy to .env for local (non-Docker) development.
# In docker-compose, these are already set via the environment: blocks.

DATABASE_URL=postgresql://notif_user:notif_pass@localhost:5432/notification_service
REDIS_URL=redis://localhost:6379/0

RATE_LIMIT_MAX_PER_HOUR=100
RATE_LIMIT_WINDOW_SECONDS=3600

MAX_RETRIES=3
RETRY_BASE_DELAY_SECONDS=30

LOG_LEVEL=INFO
ENVIRONMENT=development

# Optional: set to e.g. 0.3 to simulate a 30% provider failure rate and
# observe the retry/backoff path during a manual demo. Leave at 0 (or unset)
# for normal behavior.
FAILURE_SIMULATION_RATE=0.0
